rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /admins/{uid} {
      // Create the admin grant manually in the Firebase console, never from the client.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /articles/{articleId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
