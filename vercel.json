{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    },
    "api/v1/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/articles/:slug",
      "destination": "/api/v1/article?slug=:slug"
    },
    {
      "source": "/articles/:slug",
      "destination": "/api/v1/article-page?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/v1/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/v1/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
