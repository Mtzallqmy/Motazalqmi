# Vercel server-only environment variables. Never commit actual secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_EMAIL="author@example.com"
ADMIN_PASSWORD_HASH="32-hex-salt:128-hex-scrypt-hash"
SESSION_SECRET="random-value-at-least-32-characters"

# Server-only media and Telegram configuration
BLOB_READ_WRITE_TOKEN=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ADMIN_IDS=""
# Android release signing is held in GitHub Actions secrets, never in this file.
# ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
