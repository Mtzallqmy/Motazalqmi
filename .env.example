# Server-only: configure securely in Vercel > Project > Settings > Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_EMAIL="author@example.com"
# Hex salt and scrypt hash: use `npm run admin:generate` or node scripts/generate-admin.mjs
ADMIN_PASSWORD_HASH="<32-hex-salt>:<128-hex-hash>"
SESSION_SECRET="<at-least-32-random-characters>"
